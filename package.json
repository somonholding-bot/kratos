{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jarvis: central personal y empresarial (local)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "migrate": "node src/migrate.ts",
    "server": "node src/server.ts",
    "worker": "node src/worker.ts",
    "test": "JARVIS_DB=jarvis_test JARVIS_PORT=7499 KRATOS_DISABLE_AI=1 KRATOS_VAULT=.jarvis/vault-test node --test --test-concurrency=1 test/*.test.ts",
    "open": "node src/open.ts",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "pg": "8.23.1"
  }
}
